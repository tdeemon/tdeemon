# tdeemon's settings for compose.yaml. Copy it to .env, readable by you
# only, and fill it in:
#
#   (umask 077 && cp .env.example .env)
#
# Every setting is in docs/self-hosting.md, "Configuration".

# The public URL of this instance, without a path. Behind compose.caddy.yaml,
# its host must point at this machine.
TDEEMON_BASE_URL=https://tdeemon.example.com

# At least 32 bytes, made once and kept: openssl rand -base64 32
# It seals the single sign-on state and derives the key of Web Push; a new
# one makes every device subscribe to notifications again. Never commit it.
TDEEMON_SECRET_KEY=

# The instance's default time zone; each user picks their own.
TZ=UTC

# Behind Caddy (compose.caddy.yaml), uncomment this: every docker compose
# command then takes both files, an upgrade's too, so tdeemon stays on
# Caddy's network.
# COMPOSE_FILE=compose.yaml:compose.caddy.yaml
